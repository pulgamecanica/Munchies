# Copy to .env. Docker Compose reads it for both dev and prod. In Coolify, set these as environment variables instead.

# --- AI providers (api) ---
# Set any of these and the provider appears in the admin center (/api/admin), tied to its variable (the key is read from
# the env, never stored). <NAME>_MODELS adds models to the end of the fallback chain, in order: "model" or "model@IN/OUT"
# (USD per 1M tokens in/out; @0/0 = free, no budget). Paid models get AI_MODEL_BUDGET dollars a month each; a model with
# no known price is added switched off until you set its prices. Models are only ever added; the admin center owns the list.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5          # the model added with a new ANTHROPIC_API_KEY when ANTHROPIC_MODELS is empty
# ANTHROPIC_MODELS=claude-sonnet-5-5,claude-haiku-5-5
# OPENAI_API_KEY=
# OPENAI_MODELS=a-model@IN/OUT,another-model@IN/OUT      (check the provider's price page)
# OPENROUTER_API_KEY=
# OPENROUTER_MODELS=vendor/some-model:free@0/0            (OpenRouter's free models end in :free)
# GEMINI_API_KEY=
# GEMINI_MODELS=a-gemini-model@IN/OUT
# GROQ_API_KEY=
# GROQ_MODELS=
# MISTRAL_API_KEY=
# MISTRAL_MODELS=
# OLLAMA_URL=http://ollama:11434/v1   # self-hosted, no key; its models are free
# OLLAMA_MODELS=llama3.2
# AI_MODEL_BUDGET=50       # default monthly budget for each paid model added from here
# AI_BUDGET=100            # total cap for all paid models, until set in the admin center
# AI_BUDGET_PERIOD=month   # day | week | month
# Any provider's base URL can be overridden with <NAME>_BASE_URL (e.g. ANTHROPIC_BASE_URL).

# --- Limits (api) ---
FREE_AI_PER_MONTH=5
PAID_AI_PER_MONTH=200
SORT_FREE_PER_MONTH=3     # AI stock sorts per month (also count toward the allowance)
SORT_PAID_PER_MONTH=30
ADMIN_TOKEN=dev
# Encrypts AI provider API keys saved in the admin center (AES-256-GCM). Use `openssl rand -hex 32` in production and keep it safe:
# if it is lost or changed, saved keys must be entered again.
SECRET_KEY=

# --- Dev ports ---
PORT=3000            # site + Ghost admin (/ghost) + API (/api)
MAIL_UI_PORT=8026    # mailpit inbox, where dev sign-in links land
GHOST_VERSION=6

# --- Mail (dev defaults to mailpit; prod needs a real SMTP) ---
# MAIL_FROM=Recepees <noreply@example.com>
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# --- Production only (docker-compose.prod.yml / docker-compose.build.yml) ---
# PUBLIC_URL=https://recipes.example.com
# MYSQL_PASSWORD=

# --- OCR + hardening ---
# OCR_LANGS=eng+fra    # any of: eng fra deu spa ita por nld (add more in ocr/Dockerfile)
# API_RATE_PER_MIN=120
