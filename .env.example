# Copy to .env. Docker Compose reads it for both dev and prod. In Coolify, set these as environment variables instead.

# --- AI + limits (api) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
FREE_AI_PER_MONTH=5
PAID_AI_PER_MONTH=200
SORT_FREE_PER_MONTH=3     # AI stock sorts per month (also count toward the allowance)
SORT_PAID_PER_MONTH=30
ADMIN_TOKEN=dev

# --- Dev ports ---
PORT=3000            # site + Ghost admin (/ghost) + API (/api)
MAIL_UI_PORT=8026    # mailpit inbox, where dev sign-in links land
GHOST_VERSION=6

# --- Mail (dev defaults to mailpit; prod needs a real SMTP) ---
# MAIL_FROM=Recepees <noreply@example.com>
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# --- Production only (docker-compose.prod.yml) ---
# PUBLIC_URL=https://recipes.example.com
# MYSQL_PASSWORD=

# --- OCR + hardening ---
# OCR_LANGS=eng+fra    # any of: eng fra deu spa ita por nld (add more in ocr/Dockerfile)
# API_RATE_PER_MIN=120
