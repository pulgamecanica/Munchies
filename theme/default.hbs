<!DOCTYPE html>
<html lang="{{@site.locale}}" data-palette="{{#if @custom.palette}}{{@custom.palette}}{{else}}Enamel{{/if}}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{meta_title}}</title>
  <script>
    // Colour theme before first paint: the visitor's choice, else the site default (Ghost design setting).
    (function () { var r = document.documentElement; r.dataset.palette = r.dataset.palette.toLowerCase(); r.dataset.sitePalette = r.dataset.palette;
      try { var p = localStorage.getItem('palette'); if (p) r.dataset.palette = p; } catch (e) {} })();
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&display=swap">
  <link rel="stylesheet" href="{{asset "css/screen.css"}}">
  {{ghost_head}}
  {{!-- The pan (same as the logo) unless a Publication icon is uploaded in Ghost; after ghost_head so it wins. --}}
  {{#unless @site.icon}}
  <link rel="icon" href="{{asset "pan-icon.svg"}}" type="image/svg+xml">
  <link rel="alternate icon" href="{{asset "pan-icon.png"}}" type="image/png">
  <link rel="apple-touch-icon" href="{{asset "apple-touch-icon.png"}}">
  {{/unless}}
</head>
<body class="{{body_class}}"{{#if @member}} data-member="{{#if @member.paid}}paid{{else}}free{{/if}}"{{/if}}>
  <header class="top">
    <a class="brand" href="{{@site.url}}">{{#if @site.logo}}<img src="{{@site.logo}}" alt="">{{else}}<span class="logo">🍳</span>{{/if}}<b>{{@site.title}}</b></a>
    <nav class="links" aria-label="Main">
      <a href="{{@site.url}}/" data-nav="/" data-t>Library</a>
      <a href="{{@site.url}}/my/" data-nav="/my/" data-t>{{#if @custom.kitchen_name}}{{@custom.kitchen_name}}{{else}}My kitchen{{/if}}</a>
      {{#if @member}}<a href="#" data-portal="account" data-t>Account</a>{{else}}<a href="#" data-portal="signin" data-t>Sign in</a>{{/if}}
    </nav>
    <div class="top-actions">
      {{#if @member}}
        {{#unless @member.paid}}<a href="#" data-portal="account/plans" class="btn pro" data-t>Get Pro</a>{{/unless}}
      {{else}}
        <a href="#" data-portal="signup" class="btn primary" data-t>Create account</a>
      {{/if}}
      <details class="pal">
        <summary aria-label="Colour theme"><span class="sw" aria-hidden="true"></span></summary>
        <div class="pal-menu" role="group">
          <button type="button" data-pal="enamel"><span class="sw enamel"></span><span data-t>Enamel</span></button>
          <button type="button" data-pal="pastel"><span class="sw pastel"></span><span data-t>Pastel</span></button>
          <button type="button" data-pal="summer"><span class="sw summer"></span><span data-t>Summer</span></button>
          <button type="button" data-pal="night"><span class="sw night"></span><span data-t>Night</span></button>
        </div>
      </details>
      <select class="lang" data-lang aria-label="Language"></select>
    </div>
  </header>

  {{!-- Phones: app-style tab bar instead of a wrapping nav --}}
  <nav class="tabbar" aria-label="Main">
    <a href="{{@site.url}}/" data-nav="/"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5.5A1.5 1.5 0 0 1 5.5 4H10a2 2 0 0 1 2 2v14a2 2 0 0 0-2-2H4z"/><path d="M20 5.5A1.5 1.5 0 0 0 18.5 4H14a2 2 0 0 0-2 2v14a2 2 0 0 1 2-2h6z"/></svg><span data-t>Library</span></a>
    <a href="{{@site.url}}/my/" data-nav="/my/"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 13.9A5 5 0 0 1 7.5 4.1a5 5 0 0 1 9 0A5 5 0 0 1 18 13.9V20H6z"/><path d="M6 17h12"/></svg><span data-t>{{#if @custom.kitchen_name}}{{@custom.kitchen_name}}{{else}}My kitchen{{/if}}</span></a>
    {{#if @member}}
    <a href="#" data-portal="account"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg><span data-t>Account</span></a>
    {{else}}
    <a href="#" data-portal="signin"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><path d="M10 17l5-5-5-5M15 12H3"/></svg><span data-t>Sign in</span></a>
    {{/if}}
  </nav>
  <main class="wrap">
    {{{body}}}
  </main>
  <footer class="foot">
    <span>{{@site.title}} &middot; <span data-t>recipes you read left to right: each column combines what's behind it.</span></span>
    {{navigation type="secondary"}}
  </footer>
  <script src="{{asset "js/i18n.js"}}"></script>
  <script src="{{asset "js/timers.js"}}"></script>
  <script src="{{asset "js/recipe-table.js"}}"></script>
  {{ghost_foot}}
</body>
</html>
