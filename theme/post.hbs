{{!< default}}
{{#post}}
<article class="{{post_class}} recipe-post">
  <header class="post-head">
    <a class="back" href="{{@site.url}}/" data-t>← Library</a>
    <div class="post-title">
      <h1>{{title}}</h1>
      <dl class="spec" id="spec">
        {{#primary_author}}<div><dt data-t>By</dt><dd>{{name}}</dd></div>{{/primary_author}}
        <div><dt data-t>Published</dt><dd>{{date format="D MMM YYYY"}}</dd></div>
      </dl>
    </div>
    {{#if custom_excerpt}}<p class="lede">{{custom_excerpt}}</p>{{/if}}
  </header>
  {{#if feature_image}}
  <figure class="hero-band">
    <img src="{{img_url feature_image size="l"}}" srcset="{{img_url feature_image size="m"}} 800w, {{img_url feature_image size="l"}} 1600w" sizes="(max-width: 1200px) 100vw, 1180px" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}">
  </figure>
  {{/if}}
  <div class="gh-content">
    {{content}}
  </div>
</article>
{{/post}}
