{{!< default}}
{{#post}}
<article class="{{post_class}} recipe-post">
  <header class="post-head">
    <a class="back" href="{{@site.url}}/">← Library</a>
    <h1>{{title}}</h1>
    {{#if custom_excerpt}}<p class="lede">{{custom_excerpt}}</p>{{/if}}
    <p class="meta">{{#primary_author}}By {{name}}{{/primary_author}} &middot; {{date format="D MMM YYYY"}}{{#if reading_time}} &middot; {{reading_time}}{{/if}}</p>
    {{#if feature_image}}
    <img class="hero-img" src="{{img_url feature_image size="l"}}" srcset="{{img_url feature_image size="m"}} 800w, {{img_url feature_image size="l"}} 1600w" sizes="(max-width: 900px) 100vw, 900px" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}">
    {{/if}}
  </header>
  <div class="gh-content">
    {{content}}
  </div>
</article>
{{/post}}
